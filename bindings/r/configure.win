#!/bin/sh
# Resolve the wickra-benchmark C ABI for the Windows build.
#
# Simpler than the indicator package's equivalent, and for a reason worth
# recording: there the package object and the C ABI are both named wickra.dll, so
# the loader resolves the import back to the package itself and the ABI has to be
# staged under a different name with a hand-built import library. Here the package
# is `wickrabenchmark` and the ABI is `wickra_benchmark`, so the names never
# collide, mingw links straight against the DLL with `-l:`, and no dlltool or .def
# file is needed at all.
#
# Set WKBENCH_INC + WKBENCH_LIB to build against a locally built C ABI (dev
# override).
set -e

wkbench_download() {
  _url="$1"
  _dest="$2"
  _attempt=1
  while [ "${_attempt}" -le 6 ]; do
    if "${R_HOME}/bin/Rscript" -e "download.file('${_url}', '${_dest}', mode = 'wb', quiet = TRUE)"; then
      return 0
    fi
    echo "wickra-benchmark: download attempt ${_attempt}/6 failed (${_url}); the release asset may still be propagating — retrying in 20s..."
    sleep 20
    _attempt=$((_attempt + 1))
  done
  echo "wickra-benchmark: failed to download ${_url} after 6 attempts"
  return 1
}

# Ask R for its architecture, not the shell's. On a Windows/arm64 runner
# `uname -m` reports x86_64 because the shell runs under emulation, which would
# pull the x64 ABI into an arm64 R and fail to load ("%1 is not a valid Win32
# application"). R.version$arch reflects the R build that will load the DLL.
arch=$("${R_HOME}/bin/Rscript" -e 'cat(R.version$arch)')
case "${arch}" in
  x86_64) triple="x86_64-pc-windows-msvc" ;;
  aarch64 | arm64) triple="aarch64-pc-windows-msvc" ;;
  *)
    echo "wickra-benchmark: unsupported Windows arch '${arch}' — set WKBENCH_INC/WKBENCH_LIB"
    exit 1
    ;;
esac

if [ -n "${WKBENCH_INC}" ] && [ -n "${WKBENCH_LIB}" ]; then
  echo "wickra-benchmark: using C ABI from WKBENCH_INC / WKBENCH_LIB (dev override)"
  inc="${WKBENCH_INC}"
  lib="${WKBENCH_LIB}"
else
  version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
  url="https://github.com/wickra-lib/wickra-benchmark/releases/download/v${version}/wickra-benchmark-c-${triple}.tar.gz"
  echo "wickra-benchmark: downloading C ABI ${triple} for v${version}"
  wkbench_download "${url}" "src/wickra-benchmark-c.tar.gz" || exit 1
  "${R_HOME}/bin/Rscript" -e "untar('src/wickra-benchmark-c.tar.gz', exdir = 'src/wickra-benchmark-c')"
  inc="src/wickra-benchmark-c/wickra-benchmark-c-${triple}/include"
  lib="src/wickra-benchmark-c/wickra-benchmark-c-${triple}/lib"
fi

cp "${inc}/wickra_benchmark.h" src/wickra_benchmark.h
if [ ! -f "${lib}/wickra_benchmark.dll" ]; then
  echo "wickra-benchmark: no wickra_benchmark.dll found under ${lib}"
  exit 1
fi
cp "${lib}/wickra_benchmark.dll" src/wickra_benchmark.dll
echo "wickra-benchmark: configured (bundled wickra_benchmark.dll for ${arch})"
exit 0
