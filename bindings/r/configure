#!/bin/sh
# Resolve the wickra-benchmark C ABI (header + shared library) for the Unix build.
#
# Self-contained by default: download the prebuilt
# wickra-benchmark-c-<triple>.tar.gz release asset that matches this package's
# version and stage the shared library into src/, so the compiled package object
# links against it and bundles it (via install.libs.R), found post-install
# through an rpath ($ORIGIN on Linux, @loader_path on macOS).
#
# Before this existed the package took the ABI from WKBENCH_INC / WKBENCH_LIB and
# nothing else, with the Makevars comment describing those as "set by CI / the
# installer" -- but there was no installer, nothing bundled the library, and the
# installed package could not load it. r-universe could not have built this at
# all.
#
# Those two variables still work, as a dev override against a locally built ABI
# (e.g. after `cargo build -p wickra-benchmark-c --release`). The staging and the
# rpath happen either way, so an override build is self-contained too.
#
# Download/extract uses base R, which is always present at build time, so there
# is no curl/wget system dependency.
set -e

# A freshly cut release can briefly 404 while its assets propagate across the
# CDN, and a transient network blip should not fail an install either. Retry with
# a backoff (~2 min total) rather than giving up on the first miss.
wkbench_download() {
  _url="$1"
  _dest="$2"
  _attempt=1
  while [ "${_attempt}" -le 6 ]; do
    if "${R_HOME}/bin/Rscript" -e "download.file('${_url}', '${_dest}', mode = 'wb', quiet = TRUE)"; then
      return 0
    fi
    echo "wickra-benchmark: download attempt ${_attempt}/6 failed (${_url}); the release asset may still be propagating — retrying in 20s..."
    sleep 20
    _attempt=$((_attempt + 1))
  done
  echo "wickra-benchmark: failed to download ${_url} after 6 attempts"
  return 1
}

inc=""
lib=""

if [ -n "${WKBENCH_INC}" ] && [ -n "${WKBENCH_LIB}" ]; then
  echo "wickra-benchmark: using C ABI from WKBENCH_INC / WKBENCH_LIB (dev override)"
  inc="${WKBENCH_INC}"
  lib="${WKBENCH_LIB}"
else
  version=$(sed -n 's/^Version:[[:space:]]*//p' DESCRIPTION)
  os=$(uname -s)
  arch=$(uname -m)
  case "${os}" in
    Linux)
      case "${arch}" in
        x86_64) triple="x86_64-unknown-linux-gnu" ;;
        aarch64 | arm64) triple="aarch64-unknown-linux-gnu" ;;
        *) echo "wickra-benchmark: unsupported Linux arch '${arch}' — set WKBENCH_INC/WKBENCH_LIB"; exit 1 ;;
      esac
      ;;
    Darwin)
      case "${arch}" in
        x86_64) triple="x86_64-apple-darwin" ;;
        arm64 | aarch64) triple="aarch64-apple-darwin" ;;
        *) echo "wickra-benchmark: unsupported macOS arch '${arch}' — set WKBENCH_INC/WKBENCH_LIB"; exit 1 ;;
      esac
      ;;
    *)
      echo "wickra-benchmark: unsupported OS '${os}' — set WKBENCH_INC/WKBENCH_LIB"
      exit 1
      ;;
  esac
  url="https://github.com/wickra-lib/wickra-benchmark/releases/download/v${version}/wickra-benchmark-c-${triple}.tar.gz"
  echo "wickra-benchmark: downloading C ABI ${triple} for v${version}"
  wkbench_download "${url}" "src/wickra-benchmark-c.tar.gz" || exit 1
  "${R_HOME}/bin/Rscript" -e "untar('src/wickra-benchmark-c.tar.gz', exdir = 'src/wickra-benchmark-c')"
  inc="src/wickra-benchmark-c/wickra-benchmark-c-${triple}/include"
  lib="src/wickra-benchmark-c/wickra-benchmark-c-${triple}/lib"
fi

cp "${inc}/wickra_benchmark.h" src/wickra_benchmark.h
staged=""
for f in libwickra_benchmark.so libwickra_benchmark.dylib; do
  if [ -f "${lib}/${f}" ]; then
    cp "${lib}/${f}" "src/${f}"
    staged="${f}"
  fi
done
if [ -z "${staged}" ]; then
  echo "wickra-benchmark: no libwickra_benchmark.so/.dylib found under ${lib}"
  exit 1
fi

# rpath so the bundled library is found next to the package object after install.
case "$(uname -s)" in
  Darwin)
    rpath="-Wl,-rpath,@loader_path"
    # Normalise the dylib id to @rpath so @loader_path resolution applies.
    install_name_tool -id "@rpath/${staged}" "src/${staged}" 2>/dev/null || true
    ;;
  *)
    rpath="-Wl,-rpath,'\$\$ORIGIN'"
    ;;
esac

sed "s|@WKBENCH_RPATH@|${rpath}|" src/Makevars.in > src/Makevars
echo "wickra-benchmark: configured (bundled ${staged})"
exit 0
